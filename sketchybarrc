#!/usr/bin/env bash
# Sketchybar config. Minimal monochrome.
# Docs: https://felixkratz.github.io/SketchyBar/

PLUGIN_DIR="$CONFIG_DIR/plugins"

# Icon glyphs live once in icons.sh and are sourced here, so their raw
# UTF-8 bytes exist in a single place instead of being duplicated inline.
source "$CONFIG_DIR/icons.sh"

##### Bar appearance #####
sketchybar --bar \
  position=top \
  height=36 \
  blur_radius=30 \
  color=0x66000000 \
  padding_left=8 \
  padding_right=20 \
  corner_radius=0 \
  y_offset=0 \
  margin=0

##### Defaults applied to all items #####
default=(
  padding_left=4
  padding_right=4
  icon.font="JetBrainsMono Nerd Font:Bold:15.0"
  label.font="JetBrainsMono Nerd Font:Semibold:13.0"
  icon.color=0xffffffff
  label.color=0xffffffff
  icon.padding_left=6
  icon.padding_right=4
  label.padding_left=2
  label.padding_right=6
  background.height=22
  background.corner_radius=6
)
sketchybar --default "${default[@]}"

##### Custom events #####
sketchybar --add event mic_change
sketchybar --add event camera_change

##### Left: focused app (pill background) #####
sketchybar --add item front_app left \
           --set front_app \
             icon.drawing=off \
             label.padding_left=10 \
             label.padding_right=10 \
             background.color=0x33ffffff \
             background.drawing=on \
             script="$PLUGIN_DIR/front_app.sh" \
           --subscribe front_app front_app_switched

##### Left: next calendar meeting today (hidden when none) #####
sketchybar --add item next_meeting left \
           --set next_meeting \
             drawing=off \
             update_freq=60 \
             script="$PLUGIN_DIR/next_meeting.sh" \
             click_script="$PLUGIN_DIR/next_meeting_join.sh"

##### Left: now playing + interactive progress bar (polled every 3s) #####
sketchybar --add item media left \
           --set media \
             icon="$ICON_MUSIC" \
             label.max_chars=28 \
             scroll_texts=on \
             drawing=off \
             update_freq=3 \
             script="$PLUGIN_DIR/media.sh" \
             click_script="$PLUGIN_DIR/media_click.sh"

##### Right side. Rightmost item is added first. #####
sketchybar --add item clock right \
           --set clock update_freq=10 icon="$ICON_CLOCK" script="$PLUGIN_DIR/clock.sh" \
                  click_script="open -a Calendar" \
           --add item camera right \
           --set camera drawing=off script="$PLUGIN_DIR/camera.sh" \
           --subscribe camera camera_change \
           --add item mic right \
           --set mic drawing=off script="$PLUGIN_DIR/mic.sh" \
           --subscribe mic mic_change \
           --add item volume right \
           --set volume script="$PLUGIN_DIR/volume.sh" \
                  click_script="open 'x-apple.systempreferences:com.apple.Sound-Settings.extension'" \
           --subscribe volume volume_change mouse.scrolled \
           --add item battery right \
           --set battery update_freq=60 script="$PLUGIN_DIR/battery.sh" \
                  click_script="open 'x-apple.systempreferences:com.apple.Battery-Settings.extension'" \
           --subscribe battery system_woke power_source_change \
           --add item wifi right \
           --set wifi update_freq=30 script="$PLUGIN_DIR/wifi.sh" \
                  click_script="open 'x-apple.systempreferences:com.apple.wifi-settings-extension'" \
           --subscribe wifi wifi_change \
           --add item network right \
           --set network update_freq=2 icon="$ICON_NET" script="$PLUGIN_DIR/network.sh" \
           --add item ram right \
           --set ram update_freq=5 icon="$ICON_RAM" script="$PLUGIN_DIR/ram.sh" \
                  click_script="open -a 'Activity Monitor'" \
           --add item cpu right \
           --set cpu update_freq=5 icon="$ICON_CPU" script="$PLUGIN_DIR/cpu.sh" \
                  click_script="open -a 'Activity Monitor'"

##### Background watcher for mic/camera in-use indicators #####
"$PLUGIN_DIR/avwatch.sh" &

##### Theme #####
source "$CONFIG_DIR/themes/dracula.sh"

##### Force first run #####
sketchybar --update
